# ---- Site (também cadastradas como variáveis do repositório no GitHub) ----
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública (publishable ou anon). Pode aparecer no site sem problema.
SUPABASE_KEY=sb_publishable_xxx
OWNER_EMAIL=voce@exemplo.com

# ---- Só para a migração (nunca vão para o GitHub) ----
# Connection string do Supabase: Connect > Session pooler.
SUPABASE_DB_URL=postgresql://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# URL pública do PostgreSQL do Railway (DATABASE_PUBLIC_URL).
RAILWAY_DATABASE_URL=postgresql://postgres:senha@xxx.proxy.rlwy.net:12345/railway
# Senha de entrada no site (a migração cria o usuário com ela).
OWNER_PASSWORD=troque-esta-senha
